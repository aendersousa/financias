{
  "name": "financias",
  "version": "2.0.0",
  "description": "App desktop de gestao financeira pessoal",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:db:fresh": "powershell -NoProfile -File supabase/verify-fresh.ps1",
    "test:api:local": "node scripts/test-ledger-api.mjs",
    "test:browser:local": "node scripts/test-ledger-browser.mjs",
    "test:browser:advanced": "node scripts/test-ledger-advanced-browser.mjs",
    "test:maintenance:local": "node --test supabase/functions/daily-maintenance/index.test.mjs",
    "test:offline:local": "node scripts/test-ledger-offline-pwa.mjs",
    "dev:ledger": "node scripts/dev-ledger.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "build:pwa": "vite build --config vite.pwa.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fast-check": "^4.10.2",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.5.2",
    "@supabase/supabase-js": "^2.110.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "zustand": "^5.0.14"
  }
}
